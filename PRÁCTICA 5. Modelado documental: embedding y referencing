// Completar ventas hasta V100

for (let i = 3; i <= 100; i++) {
    let ventaId = "V" + i.toString().padStart(3, "0");
    let clienteId = "C" + (((i - 1) % 50) + 1).toString().padStart(3, "0");
    let productoId = "P" + (((i - 1) % 50) + 1).toString().padStart(3, "0");

    db.ventas.insertOne({
        venta_id: ventaId,
        cliente_id: clienteId,
        fecha: ISODate("2026-09-05T12:30:00Z"),
        items: [
            {
                sku: productoId,
                cantidad: 2,
                precio: 450
            }
        ],
        total: 900,
        canal: i % 2 === 0 ? "online" : "tienda",
        estado: "completada"
    });
}

