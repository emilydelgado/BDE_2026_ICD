use ventas_online

show collections

db.productos.countDocuments()

db.ventas.countDocuments()

db.ventas.aggregate([
    {
        $group: {
            _id: null,
            numero_ventas: { $sum: 1 }
        }
    }
])

db.ventas.aggregate([
    {
        $group: {
            _id: null,
            ingreso_total: { $sum: "$total" }
        }
    }
])

db.ventas.aggregate([
    {
        $group: {
            _id: null,
            ticket_promedio: { $avg: "$total" }
        }
    }
])

db.ventas.aggregate([
    {
        $group: {
            _id: null,
            ventas: { $sum: 1 },
            ingreso_total: { $sum: "$total" },
            ticket_promedio: { $avg: "$total" },
            venta_minima: { $min: "$total" },
            venta_maxima: { $max: "$total" }
        }
    }
])

db.ventas.aggregate([
    {
        $group: {
            _id: "$canal",
            ventas: { $sum: 1 }
        }
    }
])

db.ventas.aggregate([
    {
        $group: {
            _id: "$canal",
            ventas: { $sum: 1 },
            ingreso_total: { $sum: "$total" },
            ticket_promedio: { $avg: "$total" }
        }
    }
])

db.ventas.aggregate([
    {
        $group: {
            _id: "$canal",
            ventas: { $sum: 1 },
            ingreso_total: { $sum: "$total" }
        }
    },
    {
        $sort: {
            ingreso_total: -1
        }
    }
])

db.ventas.aggregate([
    {
        $group: {
            _id: "$estado",
            ventas: { $sum: 1 },
            ingreso_total: { $sum: "$total" }
        }
    },
    {
        $sort: {
            ventas: -1
        }
    }
])

db.ventas.aggregate([
    {
        $match: {
            estado: "completada"
        }
    },
    {
        $group: {
            _id: null,
            ventas_completadas: { $sum: 1 },
            ingreso: { $sum: "$total" },
            promedio: { $avg: "$total" }
        }
    }
])

db.ventas.aggregate([
    {
        $match: {
            estado: "completada"
        }
    },
    {
        $group: {
            _id: "$canal",
            ventas: { $sum: 1 },
            ingreso: { $sum: "$total" }
        }
    },
    {
        $sort: {
            ingreso: -1
        }
    }
])

db.ventas.aggregate([
    {
        $group: {
            _id: "$cliente_id",
            compras: { $sum: 1 },
            gasto_total: { $sum: "$total" },
            gasto_promedio: { $avg: "$total" }
        }
    },
    {
        $sort: {
            gasto_total: -1
        }
    }
])

db.ventas.aggregate([
    {
        $group: {
            _id: "$cliente_id",
            compras: { $sum: 1 },
            gasto_total: { $sum: "$total" }
        }
    },
    {
        $sort: {
            gasto_total: -1
        }
    },
    {
        $limit: 5
    }
])

db.ventas.aggregate([
    {
        $match: {
            estado: "completada"
        }
    },
    {
        $count: "ventas_completadas"
    }
])

db.ventas.aggregate([
    {
        $match: {
            estado: "completada",
            total: { $gte: 1000 }
        }
    },
    {
        $group: {
            _id: "$canal",
            ventas: { $sum: 1 },
            ingreso: { $sum: "$total" },
            promedio: { $avg: "$total" }
        }
    },
    {
        $sort: {
            ingreso: -1
        }
    }
])
